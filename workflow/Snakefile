# ============================================================================
# Snakefile
# EM-seq cfDNA downstream analysis pipeline
# ============================================================================

import pandas as pd

configfile: "config/config.yaml"


# ── Directories ──────────────────────────────────────────────────────────────

D_OUT = config.get("outdir", "results")
D_LOGS = config.get("logs", "logs")
D_BENCHMARK = config.get("benchmark", "benchmark")
D_WORK = config.get("workdir", "work")


# ── External resources ───────────────────────────────────────────────────────

R_EMSEQ = config.get("repo", ".")
ENV_METHYLKIT = config.get("env_methylkit", "envs/methylkit.yaml")


# ── Input CSVs ───────────────────────────────────────────────────────────────

SAMPLES = pd.read_csv(config["samples_csv"]).set_index("sample")

SAMPLE_CONTRASTS = pd.read_csv(
    config["sample_contrasts_csv"]
).set_index("sample")

ANALYSIS_MATRIX = pd.read_csv(
    config["analysis_matrix_csv"]
).set_index("analysis")


# ── Normalize analysis matrix ────────────────────────────────────────────────

def as_bool(x):
    return str(x).strip().lower() in ["true", "1", "yes", "y"]


ANALYSIS_MATRIX = ANALYSIS_MATRIX.applymap(as_bool)

CONTRASTS = list(SAMPLE_CONTRASTS.columns)
ANALYSES = list(ANALYSIS_MATRIX.index)


# ── General helpers ──────────────────────────────────────────────────────────

def is_not_na(x):
    return pd.notna(x) and str(x).strip().upper() != "NA"


def analysis_enabled(analysis, contrast):
    if analysis not in ANALYSIS_MATRIX.index:
        return False

    if contrast not in ANALYSIS_MATRIX.columns:
        return False

    return bool(ANALYSIS_MATRIX.loc[analysis, contrast])


def enabled_contrasts_for_analysis(analysis):
    return [
        contrast
        for contrast in CONTRASTS
        if analysis_enabled(analysis, contrast)
    ]


def samples_for_contrast(contrast):
    vals = SAMPLE_CONTRASTS[contrast]
    vals = vals[vals.apply(is_not_na)]
    return vals.index.tolist()


def groups_for_contrast(contrast):
    vals = SAMPLE_CONTRASTS[contrast]
    vals = vals[vals.apply(is_not_na)]
    return sorted(vals.unique())


def samples_for_group(contrast, group):
    vals = SAMPLE_CONTRASTS[contrast]
    vals = vals[vals.apply(is_not_na)]
    return vals[vals == group].index.tolist()


def require_two_groups(contrast):
    groups = groups_for_contrast(contrast)

    if len(groups) != 2:
        raise ValueError(
            f"Contrast {contrast} must have exactly two groups, found: {groups}"
        )

    return groups


def treatment_vector_for_contrast(contrast):
    groups = require_two_groups(contrast)

    group_to_tx = {
        groups[0]: 0,
        groups[1]: 1,
    }

    vals = SAMPLE_CONTRASTS[contrast]
    vals = vals[vals.apply(is_not_na)]

    return [group_to_tx[group] for group in vals.tolist()]


def contrast_param(contrast, param, default=None):
    return (
        config
        .get("contrast_params", {})
        .get(contrast, {})
        .get(param, default)
    )


# ── Input file helpers ───────────────────────────────────────────────────────

def methylkit_db_for_sample(sample):
    return SAMPLES.loc[sample, "gcs_methylkit_db"]

# ── Input file helpers ───────────────────────────────────────────────────────
include: rules/differential_methylation.smk

# ── Final target collection ──────────────────────────────────────────────────

def differential_methylation_outputs():
    outputs = []

    for contrast in enabled_contrasts_for_analysis("differential_methylation"):
        outputs.extend([
            f"{D_OUT}/dmr/diff/methylBase_{contrast}.txt.bgz",
            f"{D_OUT}/dmr/diff/methylDiff_{contrast}.txt.bgz",
            f"{D_OUT}/dmr/diff/methylBase_{contrast}.tiled.txt.bgz",
            f"{D_OUT}/dmr/diff/methylDiff_{contrast}.tiled.txt.bgz",
            f"{D_OUT}/dmr/diff/{contrast}_pos_meth.tsv",
            f"{D_OUT}/dmr/annotation/{contrast}_annotated.tsv",
        ])

    return outputs


def enabled_outputs():
    outputs = []

    outputs.extend(differential_methylation_outputs())

    return outputs


rule all:
    input:
        enabled_outputs


# ── Rule modules ─────────────────────────────────────────────────────────────

include: "rules/differential_methylation.smk"
