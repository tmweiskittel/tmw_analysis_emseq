import csv

configfile: "config/config.yaml"


D_OUT = config.get("outdir", "results")
D_LOGS = config.get("logs", "logs")
D_BENCHMARK = config.get("benchmark", "benchmark")
D_WORK = config.get("workdir", "work")

from pathlib import Path

WORKFLOW_DIR = workflow.basedir
R_EMSEQ = str(Path(WORKFLOW_DIR))

# do I still need this variable? recheck later
ENV_METHYLKIT = config.get("env_methylkit", "envs/methylkit.yaml")

from pathlib import Path

WORKFLOW_DIR = workflow.basedir

def clean_header(name):
    return name.strip().lstrip("\ufeff")


def read_csv_by_key(path, key_col):
    with open(path, newline="", encoding="utf-8-sig") as handle:
        reader = csv.DictReader(handle)
        reader.fieldnames = [clean_header(x) for x in reader.fieldnames]

        rows = {}
        for row in reader:
            clean_row = {
                clean_header(k): v.strip() if isinstance(v, str) else v
                for k, v in row.items()
            }
            rows[clean_row[key_col]] = clean_row

        return rows


SAMPLES = read_csv_by_key(config["samples_csv"], "sample")
SAMPLE_CONTRASTS = read_csv_by_key(config["sample_contrasts_csv"], "sample")
ANALYSIS_MATRIX = read_csv_by_key(config["analysis_matrix_csv"], "analysis")

CONTRASTS = [
    col for col in next(iter(SAMPLE_CONTRASTS.values())).keys()
    if col != "sample"
]

ANALYSES = list(ANALYSIS_MATRIX.keys())


def as_bool(x):
    return str(x).strip().lower() in ["true", "1", "yes", "y"]


def is_not_na(x):
    return (
        x is not None
        and str(x).strip() != ""
        and str(x).strip().upper() != "NA"
    )


def analysis_enabled(analysis, contrast):
    if analysis not in ANALYSIS_MATRIX:
        return False
    if contrast not in ANALYSIS_MATRIX[analysis]:
        return False
    return as_bool(ANALYSIS_MATRIX[analysis][contrast])


def enabled_contrasts_for_analysis(analysis):
    return [
        contrast
        for contrast in CONTRASTS
        if analysis_enabled(analysis, contrast)
    ]


def samples_for_contrast(contrast):
    return [
        sample
        for sample, row in SAMPLE_CONTRASTS.items()
        if is_not_na(row.get(contrast))
    ]


def groups_for_contrast(contrast):
    return sorted({
        row[contrast]
        for row in SAMPLE_CONTRASTS.values()
        if is_not_na(row.get(contrast))
    })


def samples_for_group(contrast, group):
    return [
        sample
        for sample, row in SAMPLE_CONTRASTS.items()
        if row.get(contrast) == group
    ]


def require_two_groups(contrast):
    groups = groups_for_contrast(contrast)

    if len(groups) != 2:
        raise ValueError(
            f"Contrast {contrast} must have exactly two groups, found: {groups}"
        )

    return groups


def treatment_vector_for_contrast(contrast):
    groups = require_two_groups(contrast)

    group_to_tx = {
        groups[0]: 0,
        groups[1]: 1,
    }

    return [
        group_to_tx[SAMPLE_CONTRASTS[sample][contrast]]
        for sample in samples_for_contrast(contrast)
    ]


def contrast_param(contrast, param, default=None):
    return (
        config
        .get("contrast_params", {})
        .get(contrast, {})
        .get(param, default)
    )


def gcs_sample_dir(sample):
    return SAMPLES[sample]["gcs_sample_dir"].rstrip("/")


def methylkit_db_gcs_for_sample(sample):
    return f"{gcs_sample_dir(sample)}/{sample}.CpG.methylKit.gz"


def methylkit_tbi_gcs_for_sample(sample):
    return methylkit_db_gcs_for_sample(sample) + ".tbi"


def local_methylkit_db_for_sample(sample):
    return f"{D_WORK}/methylkit_db/{sample}.CpG.methylKit.gz"


def local_methylkit_tbi_for_sample(sample):
    return local_methylkit_db_for_sample(sample) + ".tbi"


def differential_methylation_outputs():
    outputs = []

    for contrast in enabled_contrasts_for_analysis("differential_methylation"):
        outputs.extend([
            f"{D_OUT}/dmr/diff/methylBase_{contrast}.txt.bgz",
            f"{D_OUT}/dmr/diff/methylDiff_{contrast}.txt.bgz",
            f"{D_OUT}/dmr/diff/methylBase_{contrast}.tiled.txt.bgz",
            f"{D_OUT}/dmr/diff/methylDiff_{contrast}.tiled.txt.bgz",
            f"{D_OUT}/dmr/diff/{contrast}_pos_meth.tsv",
            f"{D_OUT}/dmr/annotation/{contrast}_annotated.tsv",
        ])

    return outputs


def enabled_outputs():
    outputs = []
    outputs.extend(differential_methylation_outputs())
    return outputs


rule all:
    input:
        enabled_outputs()


include: "rules/download_differential_methylation.smk"
